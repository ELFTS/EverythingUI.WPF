<UserControl x:Class="EverythingUI.Demo.Views.SliderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF">
    <StackPanel>
        <TextBlock Text="滑块控件" Style="{StaticResource PageTitleStyle}"/>

        <!-- 自适应宽度滑块 -->
        <TextBlock Text="自适应宽度（填满容器）" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <controls:EverythingSlider Margin="0,0,0,20"/>
                <controls:EverythingSlider Value="50" Margin="0,0,0,20"/>
                <controls:EverythingSlider Value="100"/>
            </StackPanel>
        </controls:EverythingCard>

        <!-- 固定宽度滑块 -->
        <TextBlock Text="固定宽度（300px）" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <controls:EverythingSlider Width="300" Margin="0,0,0,20" HorizontalAlignment="Left"/>
                <controls:EverythingSlider Width="300" Value="50" Margin="0,0,0,20" HorizontalAlignment="Left"/>
                <controls:EverythingSlider Width="300" Value="100" HorizontalAlignment="Left"/>
            </StackPanel>
        </controls:EverythingCard>

        <!-- 带值显示 -->
        <TextBlock Text="带值显示" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=Slider1, StringFormat={}{0:F0}}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <controls:EverythingSlider x:Name="Slider1" Value="25"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=Slider2, StringFormat={}{0:F0}}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <controls:EverythingSlider x:Name="Slider2" Value="75"/>
                </DockPanel>
            </StackPanel>
        </controls:EverythingCard>
    </StackPanel>
</UserControl>
