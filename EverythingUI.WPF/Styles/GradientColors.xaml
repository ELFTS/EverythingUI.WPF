<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 全局渐变起始/结束色默认值（蓝色）；ThemeManager.Initialize 会用当前主题色覆盖。
         所有控件模板通过 {DynamicResource GlobalGradientStartColor/EndColor} 引用，运行时自动跟随主题变化。 -->
    <Color x:Key="GlobalGradientStartColor">#00ACF0</Color>
    <Color x:Key="GlobalGradientEndColor">#0078D4</Color>
    <Color x:Key="GlobalTrackColor">#E3F2FD</Color>
    <SolidColorBrush x:Key="GlobalTrackBrush" Color="{StaticResource GlobalTrackColor}"/>

    <!-- 统一白色光泽层：所有控件顶部高光（VerticalAlignment=Top + HalfHeightConverter 实现半高） -->
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#CCFFFFFF"/>
        <GradientStop Offset="1" Color="#33FFFFFF"/>
    </LinearGradientBrush>

    <!-- 控件主色三段渐变（全局色开始/中间/开始），跟随主题色；常见用途：背景填充、选中条、滑块拇指等 -->
    <LinearGradientBrush x:Key="PrimaryVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{DynamicResource GlobalGradientStartColor}"/>
        <GradientStop Offset="0.5" Color="{DynamicResource GlobalGradientEndColor}"/>
        <GradientStop Offset="1" Color="{DynamicResource GlobalGradientStartColor}"/>
    </LinearGradientBrush>
</ResourceDictionary>
