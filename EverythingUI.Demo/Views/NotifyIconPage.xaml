<UserControl x:Class="EverythingUI.Demo.Views.NotifyIconPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF">
    <Grid>
        <StackPanel Margin="0,0,0,40">
                <TextBlock Text="系统托盘控件" Style="{StaticResource PageTitleStyle}"/>

                <!-- 基础用法 -->
                <TextBlock Text="基础用法" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="提示文本" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <controls:EverythingTextBox x:Name="ToolTipInput" Grid.Column="1"
                                                        Text="EverythingUI 托盘图标"
                                                        Margin="0,0,0,12"/>

                            <TextBlock Text="图标" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Grid.Row="1" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Image Source="{StaticResource TestIcon}" Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Text="（使用测试图标）" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <controls:EverythingButton Text="显示托盘图标" Click="ShowIcon_Click" Margin="0,0,12,0"/>
                            <controls:EverythingButton Text="隐藏托盘图标" Click="HideIcon_Click"/>
                        </StackPanel>

                        <controls:EverythingButton Text="显示气泡通知" Click="Balloon_Click" Margin="0,0,0,12"
                                                    IsCapsule="True"/>

                        <TextBlock x:Name="StatusLog"
                                   Text="点击「显示托盘图标」后，在任务栏通知区域查看效果。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </controls:EverythingCard>

                <!-- 右键菜单集成 -->
                <TextBlock Text="右键菜单集成" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Outlined" Padding="16">
                    <TextBlock Text="托盘图标右击后会自动弹出绑定的 EverythingContextMenu。在上方「显示托盘图标」后，右击通知区域的图标即可看到菜单。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </controls:EverythingCard>

                <!-- 托盘图标 + 右键菜单声明（ContextMenu 必须在视觉树中） -->
                <Grid>
                    <controls:EverythingNotifyIcon x:Name="NotifyIcon"
                                                   IconSource="{StaticResource TestIcon}"
                                                   ToolTipText="EverythingUI 托盘图标"
                                                   ContextMenuControl="{Binding ElementName=TrayMenu}"
                                                   MouseClick="NotifyIcon_MouseClick"
                                                   MouseDoubleClick="NotifyIcon_MouseDoubleClick"/>
                    <controls:EverythingContextMenu x:Name="TrayMenu" ItemClick="TrayMenu_ItemClick">
                        <controls:EverythingContextMenu.Items>
                            <controls:EverythingContextMenuItem Text="打开主窗口" InputGestureText="DoubleClick"/>
                            <controls:EverythingContextMenuItem IsSeparator="True"/>
                            <controls:EverythingContextMenuItem Text="显示气泡通知"/>
                            <controls:EverythingContextMenuItem Text="隐藏托盘图标"/>
                        </controls:EverythingContextMenu.Items>
                    </controls:EverythingContextMenu>
                </Grid>
        </StackPanel>
    </Grid>
</UserControl>
