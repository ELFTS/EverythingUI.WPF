<UserControl x:Class="EverythingUI.Demo.Views.ProgressBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF">
    <StackPanel>
        <TextBlock Text="进度条控件" Style="{StaticResource PageTitleStyle}"/>

        <!-- 基础进度条 -->
        <TextBlock Text="基础进度条" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <controls:EverythingProgressBar Value="0" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="25" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="50" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="75"/>
            </StackPanel>
        </controls:EverythingCard>

        <!-- 带百分比显示 -->
        <TextBlock Text="带百分比显示" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <controls:EverythingProgressBar Value="0" ShowPercentage="True" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="33" ShowPercentage="True" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="66" ShowPercentage="True" Margin="0,0,0,15"/>
                <controls:EverythingProgressBar Value="100" ShowPercentage="True"/>
            </StackPanel>
        </controls:EverythingCard>

        <!-- 动态进度演示 -->
        <TextBlock Text="动态进度演示" Style="{StaticResource SectionHeaderStyle}"/>
        <controls:EverythingCard CardVariant="Elevated" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <controls:EverythingProgressBar x:Name="AnimatedProgressBar" Value="0" ShowPercentage="True" Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">
                    <controls:EverythingButton Text="开始" Click="StartButton_Click" Margin="0,0,10,0"/>
                    <controls:EverythingButton Text="暂停" Click="PauseButton_Click" Margin="0,0,10,0"/>
                    <controls:EverythingButton Text="重置" Click="ResetButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingCard>
    </StackPanel>
</UserControl>
