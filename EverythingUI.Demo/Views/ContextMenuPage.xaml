<UserControl x:Class="EverythingUI.Demo.Views.ContextMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF">
    <Grid>
        <StackPanel Margin="0,0,0,40">
                <TextBlock Text="右键菜单控件" Style="{StaticResource PageTitleStyle}"/>

                <!-- 基础用法：在区域内右击弹出 -->
                <TextBlock Text="基础用法：在区域内右击弹出" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Elevated" Padding="0" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Border x:Name="BasicTarget"
                                Background="{DynamicResource Gray100Brush}"
                                CornerRadius="8"
                                Height="180">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="在区域内任意位置右击" HorizontalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="支持图标、文字、快捷键提示和分隔线"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <controls:EverythingContextMenu PlacementTarget="{Binding ElementName=BasicTarget}"
                                                        MinWidth="160" MaxWidth="240"
                                                        ItemHeight="34" IconSize="16"
                                                        ItemClick="BasicMenu_ItemClick">
                            <controls:EverythingContextMenu.Items>
                                <controls:EverythingContextMenuItem Text="撤销" InputGestureText="Ctrl+Z" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem Text="重做" InputGestureText="Ctrl+Y" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem IsSeparator="True"/>
                                <controls:EverythingContextMenuItem Text="剪切" InputGestureText="Ctrl+X" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem Text="复制" InputGestureText="Ctrl+C" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem Text="粘贴" InputGestureText="Ctrl+V" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem IsSeparator="True"/>
                                <controls:EverythingContextMenuItem Text="全选" InputGestureText="Ctrl+A" Icon="{StaticResource TestIcon}"/>
                            </controls:EverythingContextMenu.Items>
                        </controls:EverythingContextMenu>
                    </Grid>
                </controls:EverythingCard>

                <!-- 仅文字菜单（不设 Icon 即可） -->
                <TextBlock Text="仅文字菜单" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Elevated" Padding="0" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Border x:Name="TextOnlyTarget"
                                Background="{DynamicResource Gray100Brush}"
                                CornerRadius="8"
                                Height="140">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="右击弹出仅文字菜单" HorizontalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="不设 Icon 的菜单项自动隐藏图标列"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <controls:EverythingContextMenu PlacementTarget="{Binding ElementName=TextOnlyTarget}"
                                                        MinWidth="150" MaxWidth="220"
                                                        ItemHeight="34"
                                                        ItemClick="TextOnlyMenu_ItemClick">
                            <controls:EverythingContextMenu.Items>
                                <controls:EverythingContextMenuItem Text="打开" InputGestureText="Enter"/>
                                <controls:EverythingContextMenuItem Text="在新窗口中打开" InputGestureText="Shift+Enter"/>
                                <controls:EverythingContextMenuItem IsSeparator="True"/>
                                <controls:EverythingContextMenuItem Text="属性" InputGestureText="Alt+Enter"/>
                            </controls:EverythingContextMenu.Items>
                        </controls:EverythingContextMenu>
                    </Grid>
                </controls:EverythingCard>

                <!-- 禁用项与分隔线 -->
                <TextBlock Text="禁用项与分隔线" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Elevated" Padding="0" Margin="0,0,0,20">
                    <Grid Margin="20">
                        <Border x:Name="DisabledTarget"
                                Background="{DynamicResource Gray100Brush}"
                                CornerRadius="8"
                                Height="160">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="禁用项与分隔线示例" HorizontalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="最后一项处于禁用状态（半透明 + 不可点击）"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <controls:EverythingContextMenu PlacementTarget="{Binding ElementName=DisabledTarget}"
                                                        MinWidth="170" MaxWidth="260"
                                                        ItemHeight="34" IconSize="16"
                                                        ItemClick="DisabledMenu_ItemClick">
                            <controls:EverythingContextMenu.Items>
                                <controls:EverythingContextMenuItem Text="新建文件" InputGestureText="Ctrl+N" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem Text="打开..." InputGestureText="Ctrl+O" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem IsSeparator="True"/>
                                <controls:EverythingContextMenuItem Text="保存" InputGestureText="Ctrl+S" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem Text="另存为..." InputGestureText="Ctrl+Shift+S" Icon="{StaticResource TestIcon}"/>
                                <controls:EverythingContextMenuItem IsSeparator="True"/>
                                <controls:EverythingContextMenuItem Text="关闭" InputGestureText="Ctrl+W"/>
                                <controls:EverythingContextMenuItem Text="退出" InputGestureText="Alt+F4" IsEnabled="False"/>
                            </controls:EverythingContextMenu.Items>
                        </controls:EverythingContextMenu>
                    </Grid>
                </controls:EverythingCard>

                <!-- 点击事件日志 -->
                <TextBlock Text="点击事件" Style="{StaticResource SectionHeaderStyle}"/>
                <controls:EverythingCard CardVariant="Outlined" Padding="16">
                    <TextBlock x:Name="EventLog"
                               Text="右击上方任意区域触发菜单，点击菜单项后此处会输出点击信息。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </controls:EverythingCard>
        </StackPanel>
    </Grid>
</UserControl>
