<UserControl x:Class="EverythingUI.Demo.Views.ToolBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF">
    <UserControl.Resources>
        <x:Array x:Key="TextOnlyItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页"/>
            <controls:EverythingToolBarItem Text="产品"/>
            <controls:EverythingToolBarItem Text="订单"/>
            <controls:EverythingToolBarItem Text="设置"/>
        </x:Array>
        <x:Array x:Key="ThreeTextItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页"/>
            <controls:EverythingToolBarItem Text="产品"/>
            <controls:EverythingToolBarItem Text="订单"/>
        </x:Array>
        <x:Array x:Key="FiveTextItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页"/>
            <controls:EverythingToolBarItem Text="产品"/>
            <controls:EverythingToolBarItem Text="订单"/>
            <controls:EverythingToolBarItem Text="用户"/>
            <controls:EverythingToolBarItem Text="设置"/>
        </x:Array>
        <x:Array x:Key="EightTextItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页"/>
            <controls:EverythingToolBarItem Text="产品"/>
            <controls:EverythingToolBarItem Text="订单"/>
            <controls:EverythingToolBarItem Text="用户"/>
            <controls:EverythingToolBarItem Text="设置"/>
            <controls:EverythingToolBarItem Text="消息"/>
            <controls:EverythingToolBarItem Text="收藏"/>
            <controls:EverythingToolBarItem Text="帮助"/>
        </x:Array>
        <x:Array x:Key="IconLeftItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="产品管理" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="订单管理" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="系统设置" Icon="{StaticResource TestIcon}"/>
        </x:Array>
        <x:Array x:Key="IconTopItems" Type="controls:EverythingToolBarItem">
            <controls:EverythingToolBarItem Text="首页" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="产品" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="订单" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="用户" Icon="{StaticResource TestIcon}"/>
            <controls:EverythingToolBarItem Text="设置" Icon="{StaticResource TestIcon}"/>
        </x:Array>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,40">
            <TextBlock Text="工具栏控件" Style="{StaticResource PageTitleStyle}"/>

            <TextBlock Text="基础样式" Style="{StaticResource SectionHeaderStyle}"/>
            <controls:EverythingCard CardVariant="Elevated" Padding="24" Margin="0,0,0,30" ClipToBounds="False">
                <controls:EverythingToolBar ItemsSource="{StaticResource TextOnlyItems}"/>
            </controls:EverythingCard>

            <TextBlock Text="不同尺寸" Style="{StaticResource SectionHeaderStyle}"/>
            <controls:EverythingCard CardVariant="Elevated" Padding="24" Margin="0,0,0,30" ClipToBounds="False">
                <StackPanel>
                    <controls:EverythingToolBar ItemHeight="28" Margin="0,0,0,16" ItemsSource="{StaticResource TextOnlyItems}"/>
                    <controls:EverythingToolBar ItemHeight="36" Margin="0,0,0,16" ItemsSource="{StaticResource TextOnlyItems}"/>
                    <controls:EverythingToolBar ItemHeight="44" ItemsSource="{StaticResource TextOnlyItems}"/>
                </StackPanel>
            </controls:EverythingCard>

            <TextBlock Text="图标在左 (IconLeft)" Style="{StaticResource SectionHeaderStyle}"/>
            <controls:EverythingCard CardVariant="Elevated" Padding="24" Margin="0,0,0,30" ClipToBounds="False">
                <controls:EverythingToolBar ItemDisplayMode="IconLeft" ItemsSource="{StaticResource IconLeftItems}"/>
            </controls:EverythingCard>

            <TextBlock Text="图标在上 (IconTop)" Style="{StaticResource SectionHeaderStyle}"/>
            <controls:EverythingCard CardVariant="Elevated" Padding="24" Margin="0,0,0,30" ClipToBounds="False">
                <controls:EverythingToolBar ItemHeight="64" ItemDisplayMode="IconTop" ItemsSource="{StaticResource IconTopItems}"/>
            </controls:EverythingCard>

            <TextBlock Text="不同项目数量" Style="{StaticResource SectionHeaderStyle}"/>
            <controls:EverythingCard CardVariant="Elevated" Padding="24" Margin="0,0,0,30" ClipToBounds="False">
                <StackPanel>
                    <TextBlock Text="少量项目 (3个)" FontSize="13" Opacity="0.7" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:EverythingToolBar ItemHeight="32" Margin="0,0,0,20" ItemsSource="{StaticResource ThreeTextItems}"/>
                    <TextBlock Text="中等数量 (5个)" FontSize="13" Opacity="0.7" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:EverythingToolBar ItemHeight="32" Margin="0,0,0,20" ItemsSource="{StaticResource FiveTextItems}"/>
                    <TextBlock Text="大量项目 (8个)" FontSize="13" Opacity="0.7" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <controls:EverythingToolBar ItemHeight="32" MaxWidth="500" ItemsSource="{StaticResource EightTextItems}"/>
                </StackPanel>
            </controls:EverythingCard>
    </StackPanel>
</UserControl>
