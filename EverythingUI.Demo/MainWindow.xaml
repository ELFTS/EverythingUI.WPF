<Window x:Class="EverythingUI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:EverythingUI.WPF.Controls;assembly=EverythingUI.WPF"
        Title="EverythingUI 组件库测试程序" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="32" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 对话框标题样式 -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 对话框正文样式 -->
        <Style x:Key="DialogBodyStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 保留原生标题栏的透明拖动区域 -->
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- 顶部颜色切换栏 -->
        <Border x:Name="TopBar" Grid.Row="1" Grid.ColumnSpan="2"
                Background="Transparent" BorderBrush="Transparent"
                BorderThickness="0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="主题颜色：" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <controls:EverythingComboBox x:Name="ColorComboBox" Width="120" VerticalAlignment="Center"
                                             SelectionChanged="ColorComboBox_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- 左侧导航侧边栏 -->
        <controls:EverythingSideBar x:Name="SideBar" Grid.Row="2"
                                    SideBarWidth="250" CornerRadius="0,16,16,0"
                                    SelectedItem="{Binding SelectedCategory, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <controls:EverythingSideBar.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="Medium"/>
                </DataTemplate>
            </controls:EverythingSideBar.ItemTemplate>
        </controls:EverythingSideBar>

        <!-- 右侧内容区域 -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="2" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" Style="{StaticResource EverythingScrollViewerStyle}">
            <ContentControl x:Name="ContentFrame" Margin="30"/>
        </ScrollViewer>

        <controls:EverythingOverlayDialog x:Name="BasicDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="420">
            <StackPanel>
                <TextBlock Text="提示" Style="{StaticResource DialogTitleStyle}"/>
                <TextBlock Text="这是一个全屏遮罩对话框。对话框直接复用卡片控件，因此保持一致的圆角、阴影和内边距效果。"
                           Style="{StaticResource DialogBodyStyle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:EverythingButton Text="关闭" Click="CloseBasicDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>

        <controls:EverythingOverlayDialog x:Name="CustomDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="520" DialogMaxHeight="560"
                                          DialogPadding="28" DialogCornerRadius="24" BlurRadius="24">
            <StackPanel>
                <TextBlock Text="自定义遮罩对话框" Style="{StaticResource DialogTitleStyle}"/>
                <TextBlock Text="这个示例使用更大的模糊半径、圆角、内边距和遮罩透明度，适合强调当前任务或重要确认流程。"
                           Style="{StaticResource DialogBodyStyle}"/>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <controls:EverythingCard Margin="0,0,8,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="BlurRadius" FontWeight="SemiBold"/>
                            <TextBlock Text="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </controls:EverythingCard>
                    <controls:EverythingCard Margin="8,0,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DialogCornerRadius" FontWeight="SemiBold"/>
                            <TextBlock Text="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </controls:EverythingCard>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:EverythingButton Text="取消" Margin="0,0,10,0" Click="CloseCustomDialogButton_Click"/>
                    <controls:EverythingButton Text="确认" Click="CloseCustomDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>

        <controls:EverythingOverlayDialog x:Name="InfoDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="380"
                                          SystemIcon="Information" SystemSound="Asterisk" IconSize="48">
            <StackPanel>
                <TextBlock Text="操作成功" Style="{StaticResource DialogTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="数据已保存，系统将在稍后同步到云端。"
                           Style="{StaticResource DialogBodyStyle}" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:EverythingButton Text="知道了" Click="CloseInfoDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>

        <controls:EverythingOverlayDialog x:Name="WarningDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="380"
                                          SystemIcon="Warning" SystemSound="Exclamation" IconSize="48">
            <StackPanel>
                <TextBlock Text="注意" Style="{StaticResource DialogTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="当前操作可能会覆盖已有的本地配置，请确认是否继续。"
                           Style="{StaticResource DialogBodyStyle}" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:EverythingButton Text="取消" Margin="0,0,10,0" Click="CloseWarningDialogButton_Click"/>
                    <controls:EverythingButton Text="继续" Click="CloseWarningDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>

        <controls:EverythingOverlayDialog x:Name="ErrorDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="380"
                                          SystemIcon="Error" SystemSound="Hand" IconSize="48">
            <StackPanel>
                <TextBlock Text="操作失败" Style="{StaticResource DialogTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="无法连接到服务器，请检查网络后重试。"
                           Style="{StaticResource DialogBodyStyle}" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:EverythingButton Text="重试" Margin="0,0,10,0" Click="CloseErrorDialogButton_Click"/>
                    <controls:EverythingButton Text="关闭" Click="CloseErrorDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>

        <controls:EverythingOverlayDialog x:Name="QuestionDialog" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                          IsOpen="False" DialogWidth="380"
                                          SystemIcon="Question" SystemSound="Question" IconSize="48">
            <StackPanel>
                <TextBlock Text="确认删除" Style="{StaticResource DialogTitleStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="删除后数据将无法恢复，是否继续？"
                           Style="{StaticResource DialogBodyStyle}" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:EverythingButton Text="取消" Margin="0,0,10,0" Click="CloseQuestionDialogButton_Click"/>
                    <controls:EverythingButton Text="确认" Click="CloseQuestionDialogButton_Click"/>
                </StackPanel>
            </StackPanel>
        </controls:EverythingOverlayDialog>
    </Grid>
</Window>
