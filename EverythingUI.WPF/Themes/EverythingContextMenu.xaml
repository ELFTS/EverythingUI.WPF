<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EverythingUI.WPF.Controls">

    <!-- 统一项模板：通过 DataTrigger 区分普通项和分隔线 -->
    <DataTemplate x:Key="ContextMenuItemTemplate">
        <Grid x:Name="root" Height="{Binding ItemHeight, RelativeSource={RelativeSource AncestorType=controls:EverythingContextMenu}}">

            <!-- 分隔线 -->
            <Line x:Name="separator"
                  X1="6" X2="1000" Y1="0" Y2="0"
                  Stretch="Fill"
                  Stroke="#1F000000"
                  StrokeThickness="1"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"/>

            <!-- 普通项内容 -->
            <Border x:Name="itemRoot"
                    CornerRadius="6"
                    Padding="10,0,12,0"
                    SnapsToDevicePixels="True"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#1A000000"/>
                                            <GradientStop Offset="1" Color="#0D000000"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="icon"
                           Source="{Binding Icon}"
                           Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:EverythingContextMenu}}"
                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:EverythingContextMenu}}"
                           Stretch="Uniform"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Text}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding InputGestureText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                <Setter TargetName="separator" Property="Visibility" Value="Visible"/>
                <Setter TargetName="itemRoot" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="root" Property="Height" Value="9"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="itemRoot" Property="Opacity" Value="0.45"/>
                <Setter TargetName="itemRoot" Property="Cursor" Value="Arrow"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="itemRoot" Property="Padding" Value="12,0,12,0"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 主样式 -->
    <Style TargetType="controls:EverythingContextMenu">
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MaxWidth" Value="280"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EverythingContextMenu">
                    <Grid Background="Transparent" IsHitTestVisible="False">
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               PopupAnimation="None"
                               Placement="Absolute">
                            <Grid Background="Transparent" Margin="24">
                                <Border x:Name="rootBorder"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}"
                                        MinWidth="{TemplateBinding MinWidth}"
                                        MaxWidth="{TemplateBinding MaxWidth}"
                                        RenderTransformOrigin="0,0"
                                        Opacity="0"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="4" BlurRadius="14" Opacity="0.25" Color="Black" RenderingBias="Quality"/>
                                    </Border.Effect>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#FFFFFF"/>
                                            <GradientStop Offset="1" Color="#F4F6F9"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ItemsControl x:Name="PART_Items"
                                                  ItemTemplate="{StaticResource ContextMenuItemTemplate}"
                                                  Background="Transparent"
                                                  Focusable="False"
                                                  IsTabStop="False"/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
